# Shed sign-in: any OpenID Connect provider (Pocket ID, Authelia, Keycloak…). Redirect URI: <shed URL>/auth/callback
SHED_OIDC_ISSUER=https://auth.example.com
SHED_OIDC_CLIENT_ID=
SHED_OIDC_CLIENT_SECRET=
# Who may sign in: comma-separated email:…, user:… (provider username) or sub:…
SHED_ALLOWED_USERS=user:ada
SHED_DATA=data
# Temporary, until every page reads from Shed: a Forgejo token the old pages use for whoever is signed in
FORGEJO_TOKEN=
