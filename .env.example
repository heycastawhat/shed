# Sign-in: any OpenID Connect provider (Pocket ID, Authelia, Keycloak…). Redirect URI: <shed URL>/auth/callback
SHED_OIDC_ISSUER=https://auth.example.com
SHED_OIDC_CLIENT_ID=
SHED_OIDC_CLIENT_SECRET=
# Who may sign in: comma-separated email:…, user:… (provider username) or sub:…
SHED_ALLOWED_USERS=user:ada
# 32+ random characters; encrypts CI secrets and T3 tokens. Never change or lose it.
FORGE_SECRET=
# Where shed.db, repos, wikis, release files and CI logs live.
SHED_DATA=data
FORGE_DATA=data
# git over SSH: the port Shed listens on (0 = off), and how clone URLs name it from outside.
SHED_SSH_PORT=2222
SHED_SSH_URL=
# CI: a fixed runner registration token (optional), and where actions like actions/checkout come from.
SHED_RUNNER_TOKEN=
SHED_ACTIONS_URL=https://data.forgejo.org
# An extra T3 Code host every user gets (the Docker image sets these for its bundled T3).
T3_URL=
T3_TOKEN=
# Notification emails (optional): smtps://user:pass@mail.example.com:465
SHED_SMTP_URL=
SHED_MAIL_FROM=
